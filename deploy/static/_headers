# Copied into the static build by scripts/static/build.sh. Cloudflare Pages
# and Netlify read it; other hosts ignore it and need the same rules in their
# own config (the web container's are in docker/web/Caddyfile). The pages and
# deployment.js change on every deploy without a ?v= buster, so a browser must
# always revalidate them. Every local script and stylesheet a page loads
# carries ?v=<commit> (vendor/ files carry their version in the path), so
# those may use the host's default caching.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/area-map.html
  Cache-Control: no-cache, no-store, must-revalidate
/geofilter-builder.html
  Cache-Control: no-cache, no-store, must-revalidate
/geofilter-docs.html
  Cache-Control: no-cache, no-store, must-revalidate
/deployment.js
  Cache-Control: no-cache, no-store, must-revalidate
