# OPTIONAL PostgreSQL settings — merge into your existing private .env.
# Base Compose files need none of these. Add the matching .postgres.yml override.
# Use a different persistent directory for each production/staging instance.
# Generate a DIFFERENT value for each blank field: openssl rand -hex 32
# Keep .env private. Hexadecimal passwords can be safely embedded in the
# generated container URLs; the initializer enforces at least 32 hex digits.
# These roles are created only when PostgreSQL's data directory is empty.
# Editing these values afterward does not change existing database passwords.
POSTGRES_ADMIN_PASSWORD=
CORESCOPE_OWNER_PASSWORD=
CORESCOPE_READER_PASSWORD=
CORESCOPE_WRITER_PASSWORD=
CORESCOPE_ACCOUNTS_PASSWORD=
CORESCOPE_CHANNELS_PASSWORD=
PROD_POSTGRES_DATA_DIR=~/corescope-postgres
STAGING_POSTGRES_DATA_DIR=~/corescope-staging-postgres
# docker-compose.example.yml uses this local default instead:
POSTGRES_DATA_DIR=./postgres-data
# Existing installations keep their recorded backend on update. Changing engines
# requires the offline storage switch in docs/storage.md. Never mount two database
# servers on one persistent directory.
